{
  "name": "EntryTask",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "contracts:check": "node tools/validate-resources.cjs",
    "contracts:generate": "node tools/generate-validators.cjs",
    "architecture:check": "node tools/check-architecture.cjs",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file src/index.js --bundle-output /tmp/entrytask.android.bundle --assets-dest /tmp/entrytask-assets",
    "logs:android": "node tools/android-logs.cjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "axios": "1.20.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "8.20.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "main": "src/index.js",
  "codegenConfig": {
    "name": "EntryTaskSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.entrytask.specs"
    }
  }
}
