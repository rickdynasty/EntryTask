<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="10dp" android:background="?android:attr/selectableItemBackground" android:minHeight="80dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="42dp">
        <com.entry.biz.dashboard.ui.ServiceIconView android:id="@+id/serviceIcon" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center"/>
        <ImageView android:id="@+id/serviceImage" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:visibility="gone" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/serviceBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|top" android:background="@drawable/dashboard_soft" android:textColor="#DA394A" android:textSize="12sp" android:visibility="gone"/>
    </FrameLayout>
    <TextView android:id="@+id/serviceTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#292727" android:gravity="center"/>
</LinearLayout>
