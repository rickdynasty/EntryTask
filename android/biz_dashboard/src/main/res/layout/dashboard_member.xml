<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
    <com.entry.biz.dashboard.ui.BankHeaderView android:id="@+id/pageHeader" android:layout_width="match_parent" android:layout_height="64dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <TextView android:id="@+id/memberWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_welcome" android:textSize="23sp" android:textColor="#292727"/>
        <TextView android:id="@+id/memberSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_member_subtitle" android:textSize="15sp" android:textColor="#292727"/>
        <Button android:id="@+id/memberBenefits" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/native_member_cta" android:textColor="#FFFFFF" android:backgroundTint="#F23E50"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <TextView android:id="@+id/memberSegments" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_exclusive" android:textSize="19sp" android:textColor="#292727"/>
        <TextView android:id="@+id/memberTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_member_activities" android:textSize="20sp" android:textColor="#292727"/>
        <TextView android:id="@+id/checkinTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_checkin" android:textSize="18sp" android:textColor="#292727"/>
        <Button android:id="@+id/checkin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/native_checkin_action" android:textColor="#FFFFFF" android:backgroundTint="#F23E50"/>
        <TextView android:id="@+id/checkinRewards" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_rewards" android:textSize="13sp" android:textColor="#292727"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                <com.entry.biz.dashboard.ui.PromotionCardView android:id="@+id/customCard" android:layout_width="match_parent" android:layout_height="220dp"/>
                <Button android:id="@+id/applyCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/native_card_action" android:textColor="#FFFFFF" android:backgroundTint="#F23E50"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <com.entry.biz.dashboard.ui.PromotionCardView android:id="@+id/levelPromo" android:layout_width="match_parent" android:layout_height="132dp"/>
                <com.entry.biz.dashboard.ui.PromotionCardView android:id="@+id/bookPromo" android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/demoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_demo" android:textSize="11sp" android:textColor="#292727"/>
</LinearLayout>
