<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
    <com.entry.biz.dashboard.ui.BankHeaderView android:id="@+id/pageHeader" android:layout_width="match_parent" android:layout_height="64dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/assetTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/native_assets" android:textSize="20sp" android:fontFamily="serif" android:textStyle="bold" android:textColor="#292727"/>
            <ImageButton android:id="@+id/toggleAssets" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/dashboard_eye" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/native_eye"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/totalBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="#292727"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_total" android:textSize="14sp" android:textColor="#77716C" android:paddingVertical="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/incomeBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="24sp" android:textColor="#292727"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/native_income" android:textSize="14sp" android:textColor="#77716C" android:paddingVertical="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <TextView android:id="@+id/market" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_market" android:textSize="14sp" android:textColor="#292727"/>
    </LinearLayout>
    <com.entry.biz.dashboard.ui.ServiceGridView android:id="@+id/services" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/fundTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_funds" android:textSize="22sp" android:textColor="#292727"/>
        <TextView android:id="@+id/fundSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_fund_subtitle" android:textSize="14sp" android:textColor="#292727"/>
        <com.entry.biz.dashboard.ui.FundChartView android:id="@+id/fundChart" android:layout_width="match_parent" android:layout_height="140dp"/>
        <Button android:id="@+id/viewFunds" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/native_view" android:textColor="#FFFFFF" android:backgroundTint="#F23E50"/>
        <LinearLayout android:id="@+id/products" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
    <com.entry.biz.dashboard.ui.PromotionCardView android:id="@+id/giftPromo" android:layout_width="match_parent" android:layout_height="110dp"/>
    <TextView android:id="@+id/demoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_demo" android:textSize="11sp" android:textColor="#292727"/>
</LinearLayout>
