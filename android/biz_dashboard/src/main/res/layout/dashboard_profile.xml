<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
    <com.entry.biz.dashboard.ui.BankHeaderView android:id="@+id/pageHeader" android:layout_width="match_parent" android:layout_height="64dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/dashboard_profile_avatar" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_identity" android:textSize="21sp" android:textStyle="bold" android:textColor="#292727"/>
                <TextView android:id="@+id/lowcarbon" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_lowcarbon" android:textSize="13sp" android:textColor="#598D73" android:paddingVertical="6dp"/>
            </LinearLayout>
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/native_welcome" android:textSize="12sp" android:textColor="#8C95AD"/>
        </LinearLayout>
        <com.entry.biz.dashboard.ui.SummaryStatsView android:id="@+id/summaryStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
    </LinearLayout>
    <com.entry.biz.dashboard.ui.ServiceGridView android:id="@+id/services" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/assetTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/native_assets" android:textSize="20sp" android:fontFamily="serif" android:textStyle="bold" android:textColor="#292727"/>
            <ImageButton android:id="@+id/toggleAssets" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/dashboard_eye" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/native_eye"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/totalBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="#292727"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_total" android:textSize="14sp" android:textColor="#77716C" android:paddingVertical="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/incomeBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="24sp" android:textColor="#292727"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/native_income" android:textSize="14sp" android:textColor="#77716C" android:paddingVertical="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <TextView android:id="@+id/slogan" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_welcome" android:textSize="16sp" android:textColor="#292727"/>
        <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_welcome" android:textSize="14sp" android:textColor="#292727"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <com.entry.biz.dashboard.ui.PromotionCardView android:id="@+id/creditPromo" android:layout_width="match_parent" android:layout_height="110dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/dashboard_card">
        <TextView android:id="@+id/loanTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_loan" android:textSize="21sp" android:textColor="#292727"/>
        <TextView android:id="@+id/loanAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_loan_hint" android:textSize="24sp" android:textColor="#292727"/>
        <TextView android:id="@+id/loanHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_loan_hint" android:textSize="13sp" android:textColor="#292727"/>
        <Button android:id="@+id/borrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/native_borrow" android:textColor="#FFFFFF" android:backgroundTint="#F23E50"/>
    </LinearLayout>
    <TextView android:id="@+id/demoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/native_demo" android:textSize="11sp" android:textColor="#292727"/>
</LinearLayout>
