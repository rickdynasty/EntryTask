{
  "$id": "entrytask/checkin.submit",
  "type": "object",
  "required": [
    "businessDate",
    "checkedToday",
    "consecutiveDays",
    "energy",
    "awardedEnergy",
    "alreadyChecked",
    "rewardDays",
    "calendar",
    "rewardRule"
  ],
  "properties": {
    "businessDate": {
      "type": "string"
    },
    "checkedToday": {
      "type": "boolean"
    },
    "consecutiveDays": {
      "type": "integer"
    },
    "energy": {
      "type": "integer"
    },
    "awardedEnergy": {
      "type": "integer"
    },
    "alreadyChecked": {
      "type": "boolean"
    },
    "rewardDays": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "calendar": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "date",
          "checked"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "rewardRule": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
