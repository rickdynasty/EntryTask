{
  "$id": "entrytask/profile.summary",
  "type": "object",
  "required": [
    "nickname",
    "phoneMasked",
    "level",
    "bankCards",
    "todos",
    "coupons",
    "points",
    "energy",
    "isDemo",
    "tierName",
    "carbonLabel",
    "tierProgress"
  ],
  "properties": {
    "nickname": {
      "type": "string"
    },
    "phoneMasked": {
      "type": "string"
    },
    "level": {
      "type": "integer"
    },
    "bankCards": {
      "type": "integer"
    },
    "todos": {
      "type": "integer"
    },
    "coupons": {
      "type": "integer"
    },
    "points": {
      "type": "integer"
    },
    "energy": {
      "type": "integer"
    },
    "isDemo": {
      "type": "boolean"
    },
    "tierName": {
      "type": "string"
    },
    "carbonLabel": {
      "type": "string"
    },
    "tierProgress": {
      "type": "object",
      "required": [
        "metricCode",
        "asOf",
        "current",
        "nextThreshold",
        "isTopTier"
      ],
      "properties": {
        "metricCode": {
          "const": "monthlyAverageFinancialAssets"
        },
        "asOf": {
          "type": "string"
        },
        "current": {
          "type": "object",
          "required": [
            "currency",
            "minorUnit",
            "amountMinor"
          ],
          "properties": {
            "currency": {
              "const": "CNY"
            },
            "minorUnit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "amountMinor": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          },
          "additionalProperties": true
        },
        "nextThreshold": {
          "type": "object",
          "required": [
            "currency",
            "minorUnit",
            "amountMinor"
          ],
          "properties": {
            "currency": {
              "const": "CNY"
            },
            "minorUnit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "amountMinor": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          },
          "additionalProperties": true
        },
        "isTopTier": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
