{
  "$id": "entrytask/account.list",
  "type": "object",
  "required": [
    "items",
    "page",
    "pageSize",
    "total",
    "hasMore"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "numberMasked",
          "balance",
          "status",
          "paragraphs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "numberMasked": {
            "type": "string"
          },
          "balance": {
            "type": "object",
            "required": [
              "amountMinor",
              "currency",
              "minorUnit"
            ],
            "properties": {
              "amountMinor": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "minorUnit": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          },
          "status": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
