{
  "type": "object",
  "required": [
    "month",
    "monthlyIncome",
    "monthlyExpense",
    "creditBill",
    "loanOffer",
    "isDemo"
  ],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "monthlyIncome": {
      "type": "object",
      "required": [
        "currency",
        "minorUnit",
        "amountMinor"
      ],
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "minorUnit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "amountMinor": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      },
      "additionalProperties": true
    },
    "monthlyExpense": {
      "type": "object",
      "required": [
        "currency",
        "minorUnit",
        "amountMinor"
      ],
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "minorUnit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "amountMinor": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      },
      "additionalProperties": true
    },
    "creditBill": {
      "type": "object",
      "required": [
        "hasCard",
        "unpaid",
        "dueDate"
      ],
      "properties": {
        "hasCard": {
          "type": "boolean"
        },
        "unpaid": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "currency",
                "minorUnit",
                "amountMinor"
              ],
              "properties": {
                "currency": {
                  "const": "CNY"
                },
                "minorUnit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "amountMinor": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "loanOffer": {
      "type": "object",
      "required": [
        "marketingOnly",
        "limit",
        "annualRate"
      ],
      "properties": {
        "marketingOnly": {
          "const": true
        },
        "limit": {
          "type": "object",
          "required": [
            "currency",
            "minorUnit",
            "amountMinor"
          ],
          "properties": {
            "currency": {
              "const": "CNY"
            },
            "minorUnit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "amountMinor": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          },
          "additionalProperties": true
        },
        "annualRate": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      },
      "additionalProperties": true
    },
    "isDemo": {
      "const": true
    }
  },
  "additionalProperties": true,
  "$id": "entrytask/profile.financialOverview"
}
